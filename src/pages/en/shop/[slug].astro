---
import ProductPage from '../../../components/pages/ProductPage.astro';
import { getProducts, type Product } from '../../../lib/catalog';

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.data.slug.en }, props: { product } }));
}

const { product } = Astro.props as { product: Product };
---

<ProductPage lang="en" product={product} />
